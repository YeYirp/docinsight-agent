# 复制为 .env 后填写；不要把 .env 提交到仓库
SERVER_PORT=8080
MAX_UPLOAD_SIZE=512MB
TOMCAT_MAX_THREADS=32
TOMCAT_MIN_SPARE_THREADS=4

# 任意 OpenAI 兼容网关（DeepSeek / 硅基流动 / 自建）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
MAX_TOOL_ROUNDS=3

# 可选：不配置则只做关键词检索
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

DATABASE_URL=jdbc:sqlite:./data/docinsight.db
SQLITE_VEC_EXTENSION=
DB_POOL_SIZE=4
SOURCEFILES_ROOT=./data/sourcefiles
DOCUMENT_LEGACY_STORAGE_DIR=./data/documents

RAG_TOP_K=4
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80

# 视频知识库：需要 Python + faster-whisper
VIDEO_ENABLED=true
VIDEO_PYTHON_COMMAND=
VIDEO_WHISPER_MODEL=small
VIDEO_WHISPER_DEVICE=auto
VIDEO_WHISPER_COMPUTE_TYPE=int8
VIDEO_WHISPER_LANGUAGE=auto
VIDEO_HF_ENDPOINT=
VIDEO_MAX_SIZE_MB=500
VIDEO_MAX_DURATION_MINUTES=120
VIDEO_LEGACY_STORAGE_DIR=./data/media
VIDEO_MODEL_DIR=./data/models
VIDEO_STARTUP_TIMEOUT_SECONDS=600
VIDEO_TRANSCRIBE_TIMEOUT_MINUTES=120
VIDEO_WORKER_IDLE_MINUTES=10
